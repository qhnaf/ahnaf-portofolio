---
const certifications = [
  {
    title: 'Programmer Intern',
    provider: 'Maganghub Kemnaker at Kementerian Luar Negeri',
    year: '2026',
    link: 'https://drive.google.com/file/d/1Oa7nXpkSnmt-1dpcbnl_hFRH0j_LwKgs/view?usp=sharing',
    tags: ['WEB DEV', 'FRONT END', 'INTERN']
  },
  {
    title: 'Web Developer',
    provider: 'Dinas Kependudukan & Pencatatan Sipil Kota Semarang',
    year: '2024',
    link: 'https://drive.google.com/file/d/1LAA1NLS_-h6xLh_EXyCFJAuC1KLRD7rk/view?usp=sharing',
    tags: ['WEB DEV', 'FULL STACK', 'INTERN']
  },
  {
    title: 'Essential Programming - Fullstack Web Development',
    provider: 'LearningX',
    year: '2023',
    link: 'https://drive.google.com/file/d/1BDkSfPXS0bFlQhTNNpIU4jByqeDjcCfu/view?usp=sharing',
    tags: ['FLASK', 'JQUERY', 'MONGODB']
  },
  {
    title: 'UI/UX Design And Development',
    provider: 'LearningX',
    year: '2024',
    link: 'https://drive.google.com/file/d/1lBfxdLFi4xES-h4r96rWUj2KxLaGAlD7/view?usp=sharing',
    tags: ['FIGMA', 'WEB DESIGN', 'UI/UX']
  },
  {
    title: 'English Proficiency Test (TOEFL)',
    provider: 'Educational Testing Service (ETS)',
    year: '2025',
    link: 'https://drive.google.com/file/d/1xjbAZMObZ5BFsT6xfiAXb-4YASqEcKNT/view?usp=sharing',
    tags: ['TOEFL ITP', 'ENGLISH', 'SCORE: 520']
  }
];
---

<section id="certifications" class="certs-section">
  <!-- Interactive Ambient Background Glow -->
  <div class="ambient-glow glow-certs"></div>

  <div class="container certs-container">
    
    <!-- Section Split Header -->
    <div class="certs-header-split scroll-reveal">
      <span class="certs-index">06 / CREDENTIALS</span>
      <h2 class="certs-title gradient-text">CERTIFICATIONS</h2>
    </div>

    <!-- Responsive Grid of Brutalist Cards -->
    <div class="certs-grid">
      {certifications.map((cert, index) => (
        <div class="cert-card brutalist-card scroll-reveal" style={`transition-delay: ${index * 0.12}s;`}>
          <!-- Top Row: Badge and Year -->
          <div class="cert-header">
            <span class="cert-year">{cert.year}</span>
            <div class="cert-provider-badge">{cert.provider}</div>
          </div>

          <!-- Mid Row: Title and Info -->
          <div class="cert-body">
            <h3 class="cert-card-title">{cert.title}</h3>
          </div>

          <!-- Bottom Row: Tags and Verification Link -->
          <div class="cert-footer">
            <div class="cert-tags">
              {cert.tags.map(tag => (
                <span class="cert-tag">{tag}</span>
              ))}
            </div>
            
            <a href={cert.link} class="brutalist-btn cert-verify-btn" target="_blank" rel="noopener noreferrer">
              <span>VERIFY</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .certs-section {
    background-color: var(--bg-secondary);
    position: relative;
    border-bottom: 1.5px solid var(--color-border);
    transition: background-color 0.5s ease;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .glow-certs {
    width: 320px;
    height: 320px;
    background-color: var(--color-accent-glow);
    bottom: 10%;
    right: 15%;
    filter: blur(95px);
  }

  /* Split Header styling */
  .certs-header-split {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    border-bottom: 1.5px solid var(--color-border);
    padding-bottom: 0.8rem;
    margin-bottom: 3.5rem;
  }

  .certs-index {
    font-family: var(--font-subheading);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .certs-title {
    font-size: 2.2rem;
    line-height: 0.9;
  }

  /* Grid Layout */
  .certs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Cert Card styling */
  .cert-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
    gap: 1.5rem;
    padding: 1.25rem;
    box-shadow: 4px 4px 0px var(--color-border);
  }

  .cert-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--color-border);
  }

  /* Card Header styling */
  .cert-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .cert-year {
    font-family: var(--font-subheading);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .cert-provider-badge {
    font-family: var(--font-subheading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border);
    background-color: var(--text-primary);
    color: var(--bg-primary);
    text-transform: uppercase;
    line-height: 1.4;
    word-break: break-word;
  }

  /* Card Body styling */
  .cert-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cert-card-title {
    font-family: var(--font-subheading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  .cert-id-tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  /* Card Footer styling */
  .cert-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cert-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cert-tag {
    font-family: var(--font-subheading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    background-color: rgba(18, 28, 21, 0.03);
    color: var(--text-secondary);
  }

  .cert-verify-btn {
    font-size: 0.75rem;
    padding: 0.45rem 1rem;
    border-radius: 0;
    box-shadow: 2px 2px 0px var(--color-border);
  }

  .cert-verify-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--color-border);
  }

  /* Screen adjustments */
  @media (min-width: 768px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .certs-header-split {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      padding-bottom: 0.5rem;
      gap: 0;
    }

    .certs-title {
      font-size: 3rem;
      line-height: 0.8;
    }

    .cert-card {
      min-height: 230px;
      gap: 2rem;
      padding: 2rem;
    }

    .cert-card-title {
      font-size: 1.4rem;
    }

    .cert-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0;
    }

    .cert-provider-badge {
      font-size: 0.72rem;
    }

    /* Center the last card if odd count */
    .cert-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: 100%;
      max-width: calc(50% - 1rem);
    }
  }

  @media (min-width: 1200px) {
    .certs-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
    
    .cert-card:last-child:nth-child(odd) {
      max-width: calc(50% - 1.25rem);
    }
  }
</style>
