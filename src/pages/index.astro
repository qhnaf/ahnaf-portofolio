---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
---

<Layout 
  title="Ahnaf | Developer Portfolio" 
  description="Selamat datang di portofolio Ahnaf. Seorang developer web yang berfokus pada pembuatan website modern, berkinerja tinggi, dan memiliki interaksi visual yang memukau menggunakan Astro.js."
>
  <!-- Hero Section (Welcome) -->
  <Hero />

  <!-- About Section (Personal Info & Stats) -->
  <About />

  <!-- Skills Section (Tech Stack & Levels) -->
  <Skills />

  <!-- Projects Section (Featured Works Grid) -->
  <Projects />

  <!-- Experience Section (Learning Timeline) -->
  <Experience />

  <!-- Certifications Section -->
  <Certifications />

  <!-- Contact Section (Form & Contact Channels) -->
  <Contact />
</Layout>
